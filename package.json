{
  "name": "message-from-tomorrow",
  "version": "1.0.0",
  "private": true,
  "description": "30-second vertical 2D animated suspense short made with Remotion, React and SVG",
  "scripts": {
    "studio": "remotion studio",
    "preview": "remotion render MessageFromTomorrow out/preview-540x960.mp4 --scale=0.5",
    "render": "remotion render MessageFromTomorrow out/message-from-tomorrow.mp4 --codec=h264 --crf=18",
    "still": "remotion still MessageFromTomorrow out/still.png --frame=60",
    "typecheck": "tsc --noEmit",
    "tls:preview:ch01": "remotion render TLS-Ch01 out/the-last-signal/preview-ch01.mp4 --scale=0.5",
    "tls:render:ch01": "remotion render TLS-Ch01 out/the-last-signal/the-last-signal-ch01-1147.mp4 --codec=h264 --crf=20",
    "tls:audio": "python tools/series/build_chapter_audio.py",
    "tls:preview:ch02": "remotion render TLS-Ch02 out/the-last-signal/preview-ch02.mp4 --scale=0.5",
    "tls:render:ch02": "remotion render TLS-Ch02 out/the-last-signal/the-last-signal-ch02-three-weeks.mp4 --codec=h264 --crf=20",
    "tls:preview:ch03": "remotion render TLS-Ch03 out/the-last-signal/preview-ch03.mp4 --scale=0.5",
    "tls:render:ch03": "remotion render TLS-Ch03 out/the-last-signal/the-last-signal-ch03-dont-let-him-in.mp4 --codec=h264 --crf=20",
    "tls:preview:ch04": "remotion render TLS-Ch04 out/the-last-signal/preview-ch04.mp4 --scale=0.5",
    "tls:render:ch04": "remotion render TLS-Ch04 out/the-last-signal/the-last-signal-ch04-finale.mp4 --codec=h264 --crf=20"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@remotion/cli": "4.0.541",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.3"
  }
}
